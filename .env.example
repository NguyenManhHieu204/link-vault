# .env.example
# Copy this file to .env and replace the values if needed

# SQLite Database URL (Prisma default)
DATABASE_URL="file:./dev.db"

# NextAuth Configuration
# Generate a secret via: `openssl rand -base64 32` or https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="your-development-secret-key-at-least-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"
